# Chuoi ket noi MongoDB Atlas (bat buoc khi len Vercel)
# Dang ky mien phi tai https://mongodb.com/atlas
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/class_fund?retryWrites=true&w=majority

# Chuoi bi mat JWT (tu tao mot chuoi ngau nhien dai)
JWT_SECRET=thay_bang_mot_chuoi_bi_mat_ngau_nhien_dai
JWT_EXPIRES=7d

# Vercel Blob (luu anh hoa don / chung tu) - bat buoc khi len Vercel
# Enable trong Vercel Storage -> Blob, roi copy token vao day
BLOB_READ_WRITE_TOKEN=

# URL web (de tao link trong bao cao)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
